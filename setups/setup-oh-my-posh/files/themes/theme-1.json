{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:color15",
          "template": "\n\u256d\u2500",
          "options": {
            "cache_duration": "none"
          }
        },
        {
          "type": "session",
          "style": "diamond",
          "foreground": "p:color15",
          "background": "p:color13",
          "template": "{{ .UserName }}",
          "leading_diamond": "\ue0b6",
          "options": {
            "cache_duration": "none"
          }
        },
        {
          "type": "root",
          "style": "powerline",
          "foreground": "#ff5555",
          "background": "p:color13",
          "template": "\udb85\udc0b",
          "powerline_symbol": "\ue0b0",
          "options": {
            "cache_duration": "none"
          }
        },
        {
          "type": "os",
          "style": "powerline",
          "foreground": "p:color15",
          "background": "p:color13",
          "template": "{{ .Icon }}  ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "cache_duration": "none"
          }
        },
        {
          "type": "path",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "p:color10",
          "template": " \udb80\ude56 {{ path .Path .Location }}",
          "trailing_diamond": "\ue0b4",
          "options": {
            "cache_duration": "none",
            "style": "agnoster_short"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ffffff",
          "template": "\ue725 ({{ url .UpstreamIcon .UpstreamURL }} {{ url .HEAD .UpstreamURL }}){{ if gt .Ahead 0 }}<#000000> +{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#000000> -{{ .Behind }}</>{{ end }}{{ if .Working.Changed }}<#000000> \uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }}<#000000> \uf046 {{ .Staging.String }}</>{{ end }}",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "branch_icon": "",
            "cache_duration": "none",
            "display_changing_color": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "full_branch_path": true
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#50fa7b",
          "template": "\ue718 {{ .Full }}",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "npm",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ff5555",
          "template": "\ue71e {{ .Full }}",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "display_mode": "files",
            "extensions": [
              "package-lock.json"
            ]
          }
        },
        {
          "type": "pnpm",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ffb86c",
          "template": "\udb80\udec1 {{ .Full }}",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "display_mode": "files",
            "extensions": [
              "pnpm-lock.yaml"
            ]
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#50fa7b",
          "template": "\ue73c {{ .Full }}",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "#000000",
          "background": "#ffdd00",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "java",
          "style": "diamond",
          "foreground": "p:color13",
          "background": "#ff79c6",
          "template": "\ue738 {{ .Full }}",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "php",
          "style": "diamond",
          "foreground": "p:color15",
          "background": "#6272a4",
          "template": "\ue73d {{ .Full }}",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "foreground": "p:color15",
          "template": "\u2570\u2500 \u276f\u276f",
          "options": {
            "always_enabled": true,
            "cache_duration": "none"
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "  \u276f\u276f {{ .AbsolutePWD }} : ",
    "foreground": "p:color15",
    "background": "transparent",
    "newline": true
  },
  "palette": {
    "color0": "#11111b",
    "color1": "",
    "color2": "",
    "color3": "",
    "color4": "",
    "color5": "",
    "color6": "",
    "color7": "",
    "color8": "",
    "color9": "",
    "color10": "#74c7ec",
    "color11": "",
    "color12": "",
    "color13": "#1e1e2e",
    "color14": "",
    "color15": "#cdd6f4"
  }
}